# Copiaza acest fisier in .env si completeaza parola ta de PostgreSQL si un
# JWT_SECRET lung si aleator.
PORT=3000
CORS_ORIGIN=http://localhost:5173

DB_HOST=localhost
DB_PORT=5432
DB_NAME=campus_sports_booking
DB_USER=postgres
DB_PASSWORD=

# Secretul cu care se semneaza tokenurile de autentificare (obligatoriu).
# De exemplu: node -e "console.info(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
